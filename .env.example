# --- Runtime ---
NODE_ENV=development
PORT=8787

# --- Database ---
# Development: leave DATABASE_URL unset → local SQLite (server/data/presentation.db)
# Preview/Production (Vercel): REQUIRED — Postgres connection string
# DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require

# Optional SQLite path override (dev only)
# DB_PATH=server/data/presentation.db

# Postgres SSL: set to false only for local non-SSL Postgres
# PGSSL=false
# PG_POOL_MAX=5

# --- Auth (REQUIRED in production) ---
# Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret-min-24-chars
# JWT_EXPIRES_IN=12h

# --- Seed (only when users table is empty) ---
ADMIN_EMAIL=admin@sadad.local
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=مدیر سیستم
EDITOR_EMAIL=editor@sadad.local
EDITOR_PASSWORD=Editor@12345

# --- HTTP ---
# CORS_ORIGIN=https://your-production-domain.vercel.app
# APP_URL=https://your-production-domain.vercel.app

# Frontend API base (leave empty for same-origin / Vite proxy)
# VITE_API_BASE=

# NEVER set on Vercel:
# ALLOW_SQLITE_PROD=1
