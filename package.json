{
  "name": "sadad-executive-product-presentation",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "node server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "preview": "vite preview",
    "validate:data": "node scripts/validate-data.mjs",
    "seed:reset": "rm -f server/data/presentation.db server/data/presentation.db-wal server/data/presentation.db-shm && npm run server",
    "db:backup": "mkdir -p server/data/backups && cp -p server/data/presentation.db \"server/data/backups/presentation-$(date +%Y%m%d-%H%M%S).db\" && shasum -a 256 server/data/presentation.db > server/data/backups/presentation.db.sha256 && echo Backup OK",
    "db:migrate": "node scripts/migrate-sqlite-to-postgres.mjs",
    "db:verify": "node scripts/verify-db-counts.mjs",
    "db:schema:postgres": "node -e \"require('fs').readFileSync('server/sql/schema.postgres.sql','utf8')\" && echo schema ok"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "latest",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "latest",
    "pg": "^8.23.0",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "^7.18.3",
    "recharts": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "autoprefixer": "latest",
    "concurrently": "^10.0.5",
    "postcss": "latest",
    "tailwindcss": "latest"
  }
}
